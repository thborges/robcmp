
type SubComplex {
    w = {1:3};
    x = uint8(0);
    y = uint16(0);
    z = uint32(0);
}

type Complex {
    a = int8(0);
    b = int16(0);
    c = int32(0);
    d = SubComplex();
    m = {{0:2}:2};
    n = {{SubComplex():2}:2};
}

int8 access_matrix(int8[][] m) {
    return m[1][0];
}

int16 main() {
    cmp = Complex();
    cmps = {Complex():2};
    sarr = {0:10};
    
    r0 = sarr[5];
    if (r0 != 0) { return r0; }
    
    r1 = cmp.d.z;
    if (r1 != 0) { return r1; }
    
    r2 = cmps[1].c;
    if (r2 != 0) { return r2; }
    
    r3 = cmps[1].d.w[2];
    if (r3 != 1) { return 1-r3; }
    
    smat = {{0:2}:2};
    r4 = smat[1][1];
    if (r4 != 0) { return r4; }

    r5 = cmp.m[1][1];
    if (r5 != 0) { return r5; }

    r6 = cmps[1].n[1][1].z;
    if (r6 != 0) { return r6; }

    r7 = cmps[1].n[1][1].w[1];
    if (r7 != 1) { return 1-r7; }

    return 0;
}
