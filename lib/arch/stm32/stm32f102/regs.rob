	_res1  = uint22(0);          // Reserved, 22 bits
 }

 // I2S prescaler register
 register I2SPR_t I2SPR at 0x40013020;
 register uint32 I2SPR_raw at 0x40013020;


/* Types and registers for USART1 
  Universal synchronous asynchronous receiver transmitter
 */

 type USART1_SR_t {
	PE    = false;              // Parity error
	FE    = false;              // Framing error
	NE    = false;              // Noise error flag
	ORE   = false;              // Overrun error
	IDLE  = false;              // IDLE line detected
	RXNE  = false;              // Read data register not empty
	TC    = false;              // Transmission complete
	TXE   = false;              // Transmit data register empty
	LBD   = false;              // LIN break detection flag
	CTS   = false;              // CTS flag
	_res1 = uint22(0);          // Reserved, 22 bits
 }

 // USART1 Status register
 register USART1_SR_t USART1_USART1_SR at 0x40013800;
 register uint32 USART1_USART1_SR_raw at 0x40013800;

 type USART1_DR_t {
	DR    = uint9(0);           // Data value
	_res1 = uint23(0);          // Reserved, 23 bits
 }

 // USART1 Data register
 register USART1_DR_t USART1_USART1_DR at 0x40013804;
 register uint32 USART1_USART1_DR_raw at 0x40013804;

 type USART1_BRR_t {
	DIV_Fraction = uint4(0);           // fraction of USARTDIV
	DIV_Mantissa = uint12(0);          // mantissa of USARTDIV
	_res1        = uint16(0);          // Reserved, 16 bits
 }

 // USART1 Baud rate register
 register USART1_BRR_t USART1_USART1_BRR at 0x40013808;
 register uint32 USART1_USART1_BRR_raw at 0x40013808;

 type USART1_CR1_t {
	SBK    = false;              // Send break
	RWU    = false;              // Receiver wakeup
	RE     = false;              // Receiver enable
	TE     = false;              // Transmitter enable
	IDLEIE = false;              // IDLE interrupt enable
	RXNEIE = false;              // RXNE interrupt enable
	TCIE   = false;              // Transmission complete interrupt enable
	TXEIE  = false;              // TXE interrupt enable
	PEIE   = false;              // PE interrupt enable
	PS     = false;              // Parity selection
	PCE    = false;              // Parity control enable
	WAKE   = false;              // Wakeup method
	M      = false;              // Word length
	UE     = false;              // USART enable
	_res1  = uint18(0);          // Reserved, 18 bits
 }

 // USART1 Control register 1
 register USART1_CR1_t USART1_USART1_CR1 at 0x4001380c;
 register uint32 USART1_USART1_CR1_raw at 0x4001380c;

 type USART1_CR2_t {
	ADD   = uint4(0);           // Address of the USART node
	_res1 = false;              // Reserved, 1 bits
	LBDL  = false;              // lin break detection length
	LBDIE = false;              // LIN break detection interrupt enable
	_res2 = false;              // Reserved, 1 bits
	LBCL  = false;              // Last bit clock pulse
	CPHA  = false;              // Clock phase
	CPOL  = false;              // Clock polarity
	CLKEN = false;              // Clock enable
	STOP  = uint2(0);           // STOP bits
	LINEN = false;              // LIN mode enable
	_res3 = uint17(0);          // Reserved, 17 bits
 }

 // USART1 Control register 2
 register USART1_CR2_t USART1_USART1_CR2 at 0x40013810;
 register uint32 USART1_USART1_CR2_raw at 0x40013810;

 type USART1_CR3_t {
	EIE   = false;              // Error interrupt enable
	IREN  = false;              // IrDA mode enable
	IRLP  = false;              // IrDA low-power
	HDSEL = false;              // Half-duplex selection
	NACK  = false;              // Smartcard NACK enable
	SCEN  = false;              // Smartcard mode enable
	DMAR  = false;              // DMA enable receiver
	DMAT  = false;              // DMA enable transmitter
	RTSE  = false;              // RTS enable
	CTSE  = false;              // CTS enable
	CTSIE = false;              // CTS interrupt enable
	_res1 = uint21(0);          // Reserved, 21 bits
 }

 // USART1 Control register 3
 register USART1_CR3_t USART1_USART1_CR3 at 0x40013814;
 register uint32 USART1_USART1_CR3_raw at 0x40013814;

 type GTPR_t {
	PSC   = uint8(0);           // Prescaler value
