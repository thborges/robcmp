 register uint8 TCCR4A_raw at 0xc0;

 type TCCR4B_t {
	CS4   = uint4(0);           // Clock Select Bits
	DTPS4 = uint2(0);           // Dead Time Prescaler Bits
	PSR4  = false;              // Prescaler Reset Timer/Counter 4
	PWM4X = false;              // PWM Inversion Mode
 }

 // Timer/Counter4 Control Register B
 register TCCR4B_t TCCR4B at 0xc1;
 register uint8 TCCR4B_raw at 0xc1;

 type TCCR4C_t {
	PWM4D   = false;              // Pulse Width Modulator D Enable
	FOC4D   = false;              // Force Output Compare Match 4D
	COM4D   = uint2(0);           // Comparator D Output Mode
	COM4B0S = false;              // Comparator B Output Mode
	COM4B1S = false;              // Comparator B Output Mode
	COM4A0S = false;              // Comparator A Output Mode
	COM4A1S = false;              // Comparator A Output Mode
 }

 // Timer/Counter 4 Control Register C
 register TCCR4C_t TCCR4C at 0xc2;
 register uint8 TCCR4C_raw at 0xc2;

 type TCCR4D_t {
	WGM4  = uint2(0);           // Waveform Generation Mode bits
	FPF4  = false;              // Fault Protection Interrupt Flag
	FPAC4 = false;              // Fault Protection Analog Comparator Enable
	FPES4 = false;              // Fault Protection Edge Select
	FPNC4 = false;              // Fault Protection Noise Canceler
	FPEN4 = false;              // Fault Protection Mode Enable
	FPIE4 = false;              // Fault Protection Interrupt Enable
 }

 // Timer/Counter 4 Control Register D
 register TCCR4D_t TCCR4D at 0xc3;
 register uint8 TCCR4D_raw at 0xc3;

 type TCCR4E_t {
	OC4OE  = uint6(0);           // Output Compare Override Enable bit
	ENHC4  = false;              // Enhanced Compare/PWM Mode
	TLOCK4 = false;              // Register Update Lock
 }

 // Timer/Counter 4 Control Register E
 register TCCR4E_t TCCR4E at 0xc4;
 register uint8 TCCR4E_raw at 0xc4;

 // Timer/Counter4 Low Bytes
 register uint8 TCNT4 at 0xbe;

 type TIFR4_t {
	_res1 = uint2(0);           // Reserved, 2 bits
	TOV4  = false;              // Timer/Counter4 Overflow Flag
	_res2 = uint2(0);           // Reserved, 2 bits
	OCF4B = false;              // Output Compare Flag 4B
	OCF4A = false;              // Output Compare Flag 4A
	OCF4D = false;              // Output Compare Flag 4D
 }

 // Timer/Counter4 Interrupt Flag register
 register TIFR4_t TIFR4 at 0x00000039;
 register uint8 TIFR4_raw at 0x00000039;

 type TIMSK4_t {
	_res1  = uint2(0);           // Reserved, 2 bits
	TOIE4  = false;              // Timer/Counter4 Overflow Interrupt Enable
	_res2  = uint2(0);           // Reserved, 2 bits
	OCIE4B = false;              // Timer/Counter4 Output Compare B Match Interrupt Enable
	OCIE4A = false;              // Timer/Counter4 Output Compare A Match Interrupt Enable
	OCIE4D = false;              // Timer/Counter4 Output Compare D Match Interrupt Enable
 }

 // Timer/Counter4 Interrupt Mask Register
 register TIMSK4_t TIMSK4 at 0x72;
 register uint8 TIMSK4_raw at 0x72;


/* Types and registers for TWI 
  Two Wire Serial Interface
 */

 type TWAMR_t {
	_res1 = false;              // Reserved, 1 bits
	TWAM  = uint7(0);           // No Description.
 }

 // TWI (Slave) Address Mask Register
 register TWAMR_t TWAMR at 0xbd;
 register uint8 TWAMR_raw at 0xbd;

 type TWAR_t {
	TWGCE = false;              // TWI General Call Recognition Enable Bit
	TWA   = uint7(0);           // TWI (Slave) Address register Bits
 }

 // TWI (Slave) Address register
 register TWAR_t TWAR at 0xba;
 register uint8 TWAR_raw at 0xba;

 // TWI Bit Rate register
 register uint8 TWBR at 0x000000B8;

 type TWCR_t {
	TWIE  = false;              // TWI Interrupt Enable
	_res1 = false;              // Reserved, 1 bits
	TWEN  = false;              // TWI Enable Bit
	TWWC  = false;              // TWI Write Collision Flag
	TWSTO = false;              // TWI Stop Condition Bit
	TWSTA = false;              // TWI Start Condition Bit
	TWEA  = false;              // TWI Enable Acknowledge Bit
	TWINT = false;              // TWI Interrupt Flag
 }

 // TWI Control Register
 register TWCR_t TWCR at 0xbc;
 register uint8 TWCR_raw at 0xbc;

 // TWI Data register
 register uint8 TWDR at 0xbb;

 enum TWSR_TWPS {
	_1 = 0,  // 1
	_4 = 1,  // 4
	_16 = 2, // 16
	_64 = 3  // 64
 }

 type TWSR_t {
	TWPS  = uint2(0);           // TWI Prescaler
	_res1 = false;              // Reserved, 1 bits
	TWS   = uint5(0);           // TWI Status
 }

 // TWI Status Register
 register TWSR_t TWSR at 0xb9;
 register uint8 TWSR_raw at 0xb9;


/* Types and registers for USART1 
  USART
 */

 // USART Baud Rate Register Bytes
 register uint16 UBRR1 at 0xcc;

 type UCSR1A_t {
	MPCM1 = false;              // Multi-processor Communication Mode
	U2X1  = false;              // Double the USART transmission speed
	UPE1  = false;              // Parity Error
	DOR1  = false;              // Data overRun
	FE1   = false;              // Framing Error
	UDRE1 = false;              // USART Data Register Empty
	TXC1  = false;              // USART Transmit Complete
	RXC1  = false;              // USART Receive Complete
 }

 // USART Control and Status Register A
 register UCSR1A_t UCSR1A at 0x000000C8;
 register uint8 UCSR1A_raw at 0x000000C8;

 type UCSR1B_t {
	TXB81  = false;              // Transmit Data Bit 8
	RXB81  = false;              // Receive Data Bit 8
	UCSZ12 = false;              // Character Size
	TXEN1  = false;              // Transmitter Enable
	RXEN1  = false;              // Receiver Enable
	UDRIE1 = false;              // USART Data register Empty Interrupt Enable
	TXCIE1 = false;              // TX Complete Interrupt Enable
	RXCIE1 = false;              // RX Complete Interrupt Enable
 }

 // USART Control and Status Register B
 register UCSR1B_t UCSR1B at 0xc9;
 register uint8 UCSR1B_raw at 0xc9;

 enum UCSR1C_USBS1 {
	_1_BIT = 0, // 1-bit
	_2_BIT = 1  // 2-bit
 }

 enum UCSR1C_UPM1 {
	DISABLED = 0,             // Disabled
	RESERVED = 1,             // Reserved
	ENABLED_EVEN_PARITY = 2,  // Enabled, Even Parity
	ENABLED_ODD_PARITY = 3    // Enabled, Odd Parity
 }

 enum UCSR1C_UMSEL1 {
	ASYNCHRONOUS_USART = 0,  // Asynchronous USART
	SYNCHRONOUS_USART = 1,   // Synchronous USART
	MASTER_SPI = 3           // Master SPI
 }

 type UCSR1C_t {
	UCPOL1 = false;              // Clock Polarity
	UCSZ1  = uint2(0);           // Character Size
	USBS1  = false;              // Stop Bit Select
	UPM1   = uint2(0);           // Parity Mode Bits
	UMSEL1 = uint2(0);           // USART Mode Select
 }

 // USART Control and Status Register C
 register UCSR1C_t UCSR1C at 0xca;
 register uint8 UCSR1C_raw at 0xca;

 type UCSR1D_t {
	RTSEN = false;              // RTS Enable
	CTSEN = false;              // CTS Enable
	_res1 = uint6(0);           // Reserved, 6 bits
 }

 // USART Control and Status Register D
 register UCSR1D_t UCSR1D at 0xcb;
 register uint8 UCSR1D_raw at 0xcb;

 // USART I/O Data Register
 register uint8 UDR1 at 0xce;


