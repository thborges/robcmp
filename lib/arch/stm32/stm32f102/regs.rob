 register uint32 MPU_RNR_raw at 0xe000ed98;

 type MPU_RBAR_t {
	REGION = uint4(0);           // MPU region field
	VALID  = false;              // MPU region number valid
	ADDR   = uint27(0);          // Region base address field
 }

 // MPU region base address register
 register MPU_RBAR_t MPU_RBAR at 0xe000ed9c;
 register uint32 MPU_RBAR_raw at 0xe000ed9c;

 type MPU_RASR_t {
	ENABLE = false;              // Region enable bit.
	SIZE   = uint5(0);           // Size of the MPU protection region
	_res1  = uint2(0);           // Reserved, 2 bits
	SRD    = uint8(0);           // Subregion disable bits
	B      = false;              // memory attribute
	C      = false;              // memory attribute
	S      = false;              // Shareable memory attribute
	TEX    = uint3(0);           // memory attribute
	_res2  = uint2(0);           // Reserved, 2 bits
	AP     = uint3(0);           // Access permission
	_res3  = false;              // Reserved, 1 bits
	XN     = false;              // Instruction access disable bit
	_res4  = uint3(0);           // Reserved, 3 bits
 }

