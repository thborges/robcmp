/* Types and registers for SPI1 
  Serial peripheral interface
 */

 type SPI1_CR1_t {
	CPHA     = false;              // Clock phase
	CPOL     = false;              // Clock polarity
	MSTR     = false;              // Master selection
	BR       = uint3(0);           // Baud rate control
	SPE      = false;              // SPI enable
	LSBFIRST = false;              // Frame format
	SSI      = false;              // Internal slave select
	SSM      = false;              // Software slave management
	RXONLY   = false;              // Receive only
	DFF      = false;              // Data frame format
	CRCNEXT  = false;              // CRC transfer next
	CRCEN    = false;              // Hardware CRC calculation enable
	BIDIOE   = false;              // Output enable in bidirectional mode
	BIDIMODE = false;              // Bidirectional data mode enable
	_res1    = uint16(0);          // Reserved, 16 bits
 }

 // control register 1
 register SPI1_CR1_t SPI1_CR1 at 0x40013000;
 register uint32 SPI1_CR1_raw at 0x40013000;

 type SPI1_CR2_t {
	RXDMAEN = false;              // Rx buffer DMA enable
	TXDMAEN = false;              // Tx buffer DMA enable
	SSOE    = false;              // SS output enable
	_res1   = uint2(0);           // Reserved, 2 bits
	ERRIE   = false;              // Error interrupt enable
	RXNEIE  = false;              // RX buffer not empty interrupt enable
	TXEIE   = false;              // Tx buffer empty interrupt enable
	_res2   = uint24(0);          // Reserved, 24 bits
 }

 // control register 2
 register SPI1_CR2_t SPI1_CR2 at 0x40013004;
 register uint32 SPI1_CR2_raw at 0x40013004;

 type SPI1_SR_t {
	RXNE   = false;              // Receive buffer not empty
	TXE    = false;              // Transmit buffer empty
	CHSIDE = false;              // Channel side
	UDR    = false;              // Underrun flag
	CRCERR = false;              // CRC error flag
	MODF   = false;              // Mode fault
	OVR    = false;              // Overrun flag
	BSY    = false;              // Busy flag
	_res1  = uint24(0);          // Reserved, 24 bits
 }

 // status register
 register SPI1_SR_t SPI1_SR at 0x40013008;
 register uint32 SPI1_SR_raw at 0x40013008;

 type SPI1_DR_t {
	DR    = uint16(0);          // Data register
	_res1 = uint16(0);          // Reserved, 16 bits
 }

 // data register
 register SPI1_DR_t SPI1_DR at 0x4001300c;
 register uint32 SPI1_DR_raw at 0x4001300c;

 type SPI1_CRCPR_t {
	CRCPOLY = uint16(0);          // CRC polynomial register
	_res1   = uint16(0);          // Reserved, 16 bits
 }

 // CRC polynomial register
 register SPI1_CRCPR_t SPI1_CRCPR at 0x40013010;
 register uint32 SPI1_CRCPR_raw at 0x40013010;

 type SPI1_RXCRCR_t {
	RxCRC = uint16(0);          // Rx CRC register
	_res1 = uint16(0);          // Reserved, 16 bits
 }

 // RX CRC register
 register SPI1_RXCRCR_t SPI1_RXCRCR at 0x40013014;
 register uint32 SPI1_RXCRCR_raw at 0x40013014;

 type SPI1_TXCRCR_t {
	TxCRC = uint16(0);          // Tx CRC register
	_res1 = uint16(0);          // Reserved, 16 bits
 }

 // TX CRC register
 register SPI1_TXCRCR_t SPI1_TXCRCR at 0x40013018;
 register uint32 SPI1_TXCRCR_raw at 0x40013018;

 type I2SCFGR_t {
	CHLEN   = false;              // Channel length (number of bits per audio channel)
	DATLEN  = uint2(0);           // Data length to be transferred
	CKPOL   = false;              // Steady state clock polarity
	I2SSTD  = uint2(0);           // I2S standard selection
	_res1   = false;              // Reserved, 1 bits
	PCMSYNC = false;              // PCM frame synchronization
	I2SCFG  = uint2(0);           // I2S configuration mode
	I2SE    = false;              // I2S Enable
