	AWDCH   = uint5(0);           // Analog watchdog channel select bits
	EOCIE   = false;              // Interrupt enable for EOC
	AWDIE   = false;              // Analog watchdog interrupt enable
	JEOCIE  = false;              // Interrupt enable for injected channels
	SCAN    = false;              // Scan mode
	AWDSGL  = false;              // Enable the watchdog on a single channel in scan mode
	JAUTO   = false;              // Automatic injected group conversion
	DISCEN  = false;              // Discontinuous mode on regular channels
	JDISCEN = false;              // Discontinuous mode on injected channels
	DISCNUM = uint3(0);           // Discontinuous mode channel count
	DUALMOD = uint4(0);           // Dual mode selection
	_res1   = uint2(0);           // Reserved, 2 bits
