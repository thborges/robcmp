 register uint32 USART1_USART1_CR2_raw at 0x40013810;

 type USART1_CR3_t {
	EIE   = false;              // Error interrupt enable
	IREN  = false;              // IrDA mode enable
	IRLP  = false;              // IrDA low-power
	HDSEL = false;              // Half-duplex selection
	NACK  = false;              // Smartcard NACK enable
	SCEN  = false;              // Smartcard mode enable
	DMAR  = false;              // DMA enable receiver
	DMAT  = false;              // DMA enable transmitter
	RTSE  = false;              // RTS enable
	CTSE  = false;              // CTS enable
	CTSIE = false;              // CTS interrupt enable
	_res1 = uint21(0);          // Reserved, 21 bits
 }

 // USART1 Control register 3
 register USART1_CR3_t USART1_USART1_CR3 at 0x40013814;
 register uint32 USART1_USART1_CR3_raw at 0x40013814;

