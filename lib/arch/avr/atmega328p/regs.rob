	LPM_DISABLE = 1,      // LPM prohibited in Application Section
	SPM_DISABLE = 2,      // SPM prohibited in Application Section
	NO_LOCK = 3           // No lock on SPM and LPM in Application Section
 }

 enum LOCKBIT_BLB1 {
	LPM_SPM_DISABLE = 0,  // LPM and SPM prohibited in Boot Section
	LPM_DISABLE = 1,      // LPM prohibited in Boot Section
	SPM_DISABLE = 2,      // SPM prohibited in Boot Section
	NO_LOCK = 3           // No lock on SPM and LPM in Boot Section
 }

 type LOCKBIT_t {
	LB    = uint2(0);           // Memory Lock
	BLB0  = uint2(0);           // Boot Loader Protection Mode
	BLB1  = uint2(0);           // Boot Loader Protection Mode
	_res1 = uint2(0);           // Reserved, 2 bits
 }

 // No Description.
 register LOCKBIT_t LOCKBIT at 0x00000000;
 register uint8 LOCKBIT_raw at 0x00000000;


