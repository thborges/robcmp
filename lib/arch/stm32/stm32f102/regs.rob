/* Types and registers for I2C1 
  Inter integrated circuit
 */

 type I2C1_CR1_t {
	PE        = false;              // Peripheral enable
	SMBUS     = false;              // SMBus mode
	_res1     = false;              // Reserved, 1 bits
	SMBTYPE   = false;              // SMBus type
	ENARP     = false;              // ARP enable
	ENPEC     = false;              // PEC enable
	ENGC      = false;              // General call enable
	NOSTRETCH = false;              // Clock stretching disable (Slave mode)
	START     = false;              // Start generation
	STOP      = false;              // Stop generation
	ACK       = false;              // Acknowledge enable
	POS       = false;              // Acknowledge/PEC Position (for data reception)
	PEC       = false;              // Packet error checking
	ALERT     = false;              // SMBus alert
	_res2     = false;              // Reserved, 1 bits
	SWRST     = false;              // Software reset
	_res3     = uint16(0);          // Reserved, 16 bits
 }

 // I2C1 Control register 1
 register I2C1_CR1_t I2C1_I2C1_CR1 at 0x40005400;
 register uint32 I2C1_I2C1_CR1_raw at 0x40005400;

 type I2C1_CR2_t {
	FREQ    = uint6(0);           // Peripheral clock frequency
	_res1   = uint2(0);           // Reserved, 2 bits
	ITERREN = false;              // Error interrupt enable
	ITEVTEN = false;              // Event interrupt enable
	ITBUFEN = false;              // Buffer interrupt enable
	DMAEN   = false;              // DMA requests enable
	LAST    = false;              // DMA last transfer
	_res2   = uint19(0);          // Reserved, 19 bits
 }

 // I2C1 Control register 2
 register I2C1_CR2_t I2C1_I2C1_CR2 at 0x40005404;
 register uint32 I2C1_I2C1_CR2_raw at 0x40005404;

 type OAR1_t {
	ADD0    = false;              // Interface address
	ADD7    = uint7(0);           // Interface address
	ADD10   = uint2(0);           // Interface address
	_res1   = uint5(0);           // Reserved, 5 bits
	ADDMODE = false;              // Addressing mode (slave mode)
	_res2   = uint16(0);          // Reserved, 16 bits
 }

 // I2C1 Own address register 1
 register OAR1_t I2C1_OAR1 at 0x40005408;
 register uint32 I2C1_OAR1_raw at 0x40005408;

 type OAR2_t {
	ENDUAL = false;              // Dual addressing mode enable
	ADD2   = uint7(0);           // Interface address
	_res1  = uint24(0);          // Reserved, 24 bits
 }

 // I2C1 Own address register 2
 register OAR2_t I2C1_OAR2 at 0x4000540c;
 register uint32 I2C1_OAR2_raw at 0x4000540c;

 type I2C1_DR_t {
	DR    = uint8(0);           // 8-bit data register
	_res1 = uint24(0);          // Reserved, 24 bits
 }

 // I2C1 Data register
 register I2C1_DR_t I2C1_I2C1_DR at 0x40005410;
 register uint32 I2C1_I2C1_DR_raw at 0x40005410;

 type SR1_t {
	SB       = false;              // Start bit (Master mode)
	ADDR     = false;              // Address sent (master mode)/matched (slave mode)
	BTF      = false;              // Byte transfer finished
	ADD10    = false;              // 10-bit header sent (Master mode)
	STOPF    = false;              // Stop detection (slave mode)
	_res1    = false;              // Reserved, 1 bits
	RxNE     = false;              // Data register not empty (receivers)
	TxE      = false;              // Data register empty (transmitters)
	BERR     = false;              // Bus error
	ARLO     = false;              // Arbitration lost (master mode)
	AF       = false;              // Acknowledge failure
	OVR      = false;              // Overrun/Underrun
	PECERR   = false;              // PEC Error in reception
	_res2    = false;              // Reserved, 1 bits
	TIMEOUT  = false;              // Timeout or Tlow error
	SMBALERT = false;              // SMBus alert
	_res3    = uint16(0);          // Reserved, 16 bits
 }

 // I2C1 Status register 1
 register SR1_t I2C1_SR1 at 0x40005414;
 register uint32 I2C1_SR1_raw at 0x40005414;

 type SR2_t {
	MSL        = false;              // Master/slave
	BUSY       = false;              // Bus busy
	TRA        = false;              // Transmitter/receiver
	_res1      = false;              // Reserved, 1 bits
	GENCALL    = false;              // General call address (Slave mode)
	SMBDEFAULT = false;              // SMBus device default address (Slave mode)
	SMBHOST    = false;              // SMBus host header (Slave mode)
	DUALF      = false;              // Dual flag (Slave mode)
	PEC        = uint8(0);           // acket error checking register
	_res2      = uint16(0);          // Reserved, 16 bits
 }

 // I2C1 Status register 2
 register SR2_t I2C1_SR2 at 0x40005418;
 register uint32 I2C1_SR2_raw at 0x40005418;

 type I2C1_CCR_t {
	CCR   = uint12(0);          // Clock control register in Fast/Standard mode (Master mode)
	_res1 = uint2(0);           // Reserved, 2 bits
	DUTY  = false;              // Fast mode duty cycle
	F_S   = false;              // I2C master mode selection
	_res2 = uint16(0);          // Reserved, 16 bits
 }

 // I2C1 Clock control register
 register I2C1_CCR_t I2C1_I2C1_CCR at 0x4000541c;
 register uint32 I2C1_I2C1_CCR_raw at 0x4000541c;

 type TRISE_t {
	TRISE = uint6(0);           // Maximum rise time in Fast/Standard mode (Master mode)
	_res1 = uint26(0);          // Reserved, 26 bits
 }

 // I2C1 TRISE register
 register TRISE_t I2C1_TRISE at 0x40005420;
 register uint32 I2C1_TRISE_raw at 0x40005420;


/* Types and registers for I2C2  */

