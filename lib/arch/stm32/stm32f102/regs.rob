/* Types and registers for ADC1 
  Analog to digital converter
 */

 type ADC1_SR_t {
	AWD   = false;              // Analog watchdog flag
	EOC   = false;              // Regular channel end of conversion
	JEOC  = false;              // Injected channel end of conversion
	JSTRT = false;              // Injected channel start flag
	STRT  = false;              // Regular channel start flag
	_res1 = uint27(0);          // Reserved, 27 bits
 }

 // ADC1 status register
 register ADC1_SR_t ADC1_ADC1_SR at 0x40012400;
 register uint32 ADC1_ADC1_SR_raw at 0x40012400;

