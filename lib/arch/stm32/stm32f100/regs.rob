	CC2IE = false;              // Capture/Compare 2 interrupt enable
	CC3IE = false;              // Capture/Compare 3 interrupt enable
	CC4IE = false;              // Capture/Compare 4 interrupt enable
	_res1 = false;              // Reserved, 1 bits
	TIE   = false;              // Trigger interrupt enable
	_res2 = false;              // Reserved, 1 bits
	UDE   = false;              // Update DMA request enable
	CC1DE = false;              // Capture/Compare 1 DMA request enable
	CC2DE = false;              // Capture/Compare 2 DMA request enable
	CC3DE = false;              // Capture/Compare 3 DMA request enable
	CC4DE = false;              // Capture/Compare 4 DMA request enable
	_res3 = false;              // Reserved, 1 bits
	TDE   = false;              // Trigger DMA request enable
	_res4 = uint17(0);          // Reserved, 17 bits
 }

 // TIM2 DMA/Interrupt enable register
 register TIM2_DIER_t TIM2_TIM2_DIER at 0x4000000c;
 register uint32 TIM2_TIM2_DIER_raw at 0x4000000c;

