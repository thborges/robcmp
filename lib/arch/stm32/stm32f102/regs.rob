  Advanced timer
 */

 type TIM8_CR1_t {
	CEN   = false;              // Counter enable
	UDIS  = false;              // Update disable
	URS   = false;              // Update request source
	OPM   = false;              // One-pulse mode
	DIR   = false;              // Direction
	CMS   = uint2(0);           // Center-aligned mode selection
	ARPE  = false;              // Auto-reload preload enable
	CKD   = uint2(0);           // Clock division
	_res1 = uint22(0);          // Reserved, 22 bits
 }

 // TIM8 control register 1
 register TIM8_CR1_t TIM8_TIM8_CR1 at 0x40013400;
 register uint32 TIM8_TIM8_CR1_raw at 0x40013400;

 type TIM8_CR2_t {
	CCPC  = false;              // Capture/compare preloaded control
	_res1 = false;              // Reserved, 1 bits
	CCUS  = false;              // Capture/compare control update selection
	CCDS  = false;              // Capture/compare DMA selection
	MMS   = uint3(0);           // Master mode selection
	TI1S  = false;              // TI1 selection
	OIS1  = false;              // Output Idle state 1
