  General purpose timer
 */

 type TIM2_CR1_t {
	CEN   = false;              // Counter enable
	UDIS  = false;              // Update disable
	URS   = false;              // Update request source
	OPM   = false;              // One-pulse mode
	DIR   = false;              // Direction
	CMS   = uint2(0);           // Center-aligned mode selection
	ARPE  = false;              // Auto-reload preload enable
	CKD   = uint2(0);           // Clock division
	_res1 = uint22(0);          // Reserved, 22 bits
 }

