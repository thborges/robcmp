/* Types and registers for TC0 
  Timer/Counter, 8-bit
 */

 type TC0_GTCCR_t {
	PSRSYNC = false;              // Prescaler Reset Timer/Counter1 and Timer/Counter0
	_res1   = uint6(0);           // Reserved, 6 bits
	TSM     = false;              // Timer/Counter Synchronization Mode
 }

 // General Timer/Counter Control Register
 register TC0_GTCCR_t TC0_GTCCR at 0x43;
 register uint8 TC0_GTCCR_raw at 0x43;

 // Timer/Counter0 Output Compare Register
 register uint8 OCR0A at 0x47;

 // Timer/Counter0 Output Compare Register
 register uint8 OCR0B at 0x48;

 type TCCR0A_t {
	WGM0  = uint2(0);           // Waveform Generation Mode
	_res1 = uint2(0);           // Reserved, 2 bits
	COM0B = uint2(0);           // Compare Output Mode, Fast PWm
	COM0A = uint2(0);           // Compare Output Mode, Phase Correct PWM Mode
 }

 // Timer/Counter Control Register A
 register TCCR0A_t TCCR0A at 0x44;
 register uint8 TCCR0A_raw at 0x44;

 enum TCCR0B_CS0 {
	NO_CLOCK_SOURCE_STOPPED = 0,         // No Clock Source (Stopped)
	RUNNING_NO_PRESCALING = 1,           // Running, No Prescaling
	RUNNING_CLK_8 = 2,                   // Running, CLK/8
	RUNNING_CLK_64 = 3,                  // Running, CLK/64
	RUNNING_CLK_256 = 4,                 // Running, CLK/256
	RUNNING_CLK_1024 = 5,                // Running, CLK/1024
	RUNNING_EXTCLK_TN_FALLING_EDGE = 6,  // Running, ExtClk Tn Falling Edge
	RUNNING_EXTCLK_TN_RISING_EDGE = 7    // Running, ExtClk Tn Rising Edge
 }

 type TCCR0B_t {
	CS0   = uint3(0);           // Clock Select
	WGM02 = false;              // No Description.
	_res1 = uint2(0);           // Reserved, 2 bits
	FOC0B = false;              // Force Output Compare B
	FOC0A = false;              // Force Output Compare A
 }

 // Timer/Counter Control Register B
 register TCCR0B_t TCCR0B at 0x45;
 register uint8 TCCR0B_raw at 0x45;

 // Timer/Counter0
 register uint8 TCNT0 at 0x46;

 type TIFR0_t {
	TOV0  = false;              // Timer/Counter0 Overflow Flag
	OCF0A = false;              // Timer/Counter0 Output Compare Flag 0A
	OCF0B = false;              // Timer/Counter0 Output Compare Flag 0B
	_res1 = uint5(0);           // Reserved, 5 bits
 }

 // Timer/Counter0 Interrupt Flag register
 register TIFR0_t TIFR0 at 0x00000035;
 register uint8 TIFR0_raw at 0x00000035;

 type TIMSK0_t {
	TOIE0  = false;              // Timer/Counter0 Overflow Interrupt Enable
	OCIE0A = false;              // Timer/Counter0 Output Compare Match A Interrupt Enable
	OCIE0B = false;              // Timer/Counter0 Output Compare Match B Interrupt Enable
	_res1  = uint5(0);           // Reserved, 5 bits
 }

 // Timer/Counter0 Interrupt Mask Register
 register TIMSK0_t TIMSK0 at 0x6e;
 register uint8 TIMSK0_raw at 0x6e;


