	RUNNING_EXTCLK_TN_FALLING_EDGE = 6,  // Running, ExtClk Tn Falling Edge
	RUNNING_EXTCLK_TN_RISING_EDGE = 7    // Running, ExtClk Tn Rising Edge
 }

 type TCCR0B_t {
	CS0   = uint3(0);           // Clock Select
	WGM02 = false;              // No Description.
	_res1 = uint2(0);           // Reserved, 2 bits
	FOC0B = false;              // Force Output Compare B
	FOC0A = false;              // Force Output Compare A
 }

 // Timer/Counter Control Register B
 register TCCR0B_t TCCR0B at 0x53;
 register uint8 TCCR0B_raw at 0x53;

 // Timer/Counter0
 register uint8 TCNT0 at 0x52;

 type TC0_TIFR_t {
	_res1 = false;              // Reserved, 1 bits
	TOV0  = false;              // Timer/Counter0 Overflow Flag
	_res2 = false;              // Reserved, 1 bits
	OCF0B = false;              // Timer/Counter0 Output Compare Flag 0B
	OCF0A = false;              // Timer/Counter0 Output Compare Flag 0A
	_res3 = uint3(0);           // Reserved, 3 bits
 }

 // Timer/Counter0 Interrupt Flag register
 register TC0_TIFR_t TC0_TIFR at 0x58;
 register uint8 TC0_TIFR_raw at 0x58;

 type TC0_TIMSK_t {
	_res1  = false;              // Reserved, 1 bits
	TOIE0  = false;              // Timer/Counter0 Overflow Interrupt Enable
	_res2  = false;              // Reserved, 1 bits
	OCIE0B = false;              // Timer/Counter0 Output Compare Match B Interrupt Enable
	OCIE0A = false;              // Timer/Counter0 Output Compare Match A Interrupt Enable
	_res3  = uint3(0);           // Reserved, 3 bits
 }

 // Timer/Counter Interrupt Mask Register
 register TC0_TIMSK_t TC0_TIMSK at 0x59;
 register uint8 TC0_TIMSK_raw at 0x59;


/* Types and registers for TC1 
  Timer/Counter, 16-bit
 */

 type DT1A_t {
	DTVL = uint4(0);           // No Description.
	DTVH = uint4(0);           // No Description.
 }

 // Dead time value register
 register DT1A_t DT1A at 0x45;
 register uint8 DT1A_raw at 0x45;

 type DT1B_t {
	DTVL = uint4(0);           // No Description.
	DTVH = uint4(0);           // No Description.
 }

 // Dead time value B
 register DT1B_t DT1B at 0x44;
 register uint8 DT1B_raw at 0x44;

 type DTPS_t {
	DTPS  = uint2(0);           // No Description.
	_res1 = uint6(0);           // Reserved, 6 bits
 }

 // Dead time prescaler register
 register DTPS_t DTPS at 0x00000043;
 register uint8 DTPS_raw at 0x00000043;

 type TC1_GTCCR_t {
	_res1 = false;              // Reserved, 1 bits
	PSR1  = false;              // Prescaler Reset Timer/Counter1
	FOC1A = false;              // Force Output Compare 1A
	FOC1B = false;              // Force Output Compare Match 1B
	COM1B = uint2(0);           // Comparator B Output Mode
	PWM1B = false;              // Pulse Width Modulator B Enable
	_res2 = false;              // Reserved, 1 bits
 }

 // Timer counter control register
 register TC1_GTCCR_t TC1_GTCCR at 0x4c;
 register uint8 TC1_GTCCR_raw at 0x4c;

 // Output Compare Register
 register uint8 OCR1A at 0x4e;

 // Output Compare Register
 register uint8 OCR1B at 0x4b;

 // Output compare register
 register uint8 OCR1C at 0x4d;

 enum TCCR1_CS1 {
	NO_CLOCK_SOURCE_STOPPED = 0,  // No Clock Source (Stopped)
	RUNNING_NO_PRESCALING = 1,    // Running, No Prescaling
	RUNNING_CLK_2 = 2,            // Running, CLK/2
	RUNNING_CLK_4 = 3,            // Running, CLK/4
	RUNNING_CLK_8 = 4,            // Running, CLK/8
	RUNNING_CLK_16 = 5,           // Running, CLK/16
	RUNNING_CLK_32 = 6,           // Running, CLK/32
	RUNNING_CLK_64 = 7,           // Running, CLK/64
	RUNNING_CLK_128 = 8,          // Running, CLK/128
	RUNNING_CLK_256 = 9,          // Running, CLK/256
	RUNNING_CLK_512 = 10,         // Running, CLK/512
	RUNNING_CLK_1024 = 11,        // Running, CLK/1024
	RUNNING_CLK_2048 = 12,        // Running, CLK/2048
	RUNNING_CLK_4096 = 13,        // Running, CLK/4096
	RUNNING_CLK_8192 = 14,        // Running, CLK/8192
	RUNNING_CLK_16384 = 15        // Running, CLK/16384
 }

 enum TCCR1_COM1A {
	DISCONNECTED_FROM_OCN_PWMN = 0,   // Disconnected from OCn/PWMn
	TOGGLE_OCN_PWMN_OUTPUT_LINE = 1,  // Toggle OCn/PWMn output line
	CLEAR_OCN_PWMN_OUTPUT_LINE = 2,   // Clear OCn/PWMn output line
	SET_OCN_PWMN_OUTPUT_LINE = 3      // set OCn/PWMn output line
 }

 type TCCR1_t {
	CS1   = uint4(0);           // Clock Select Bits
	COM1A = uint2(0);           // Compare Output Mode, Bits
	PWM1A = false;              // Pulse Width Modulator Enable
	CTC1  = false;              // Clear Timer/Counter on Compare Match
 }

 // Timer/Counter Control Register
 register TCCR1_t TCCR1 at 0x50;
 register uint8 TCCR1_raw at 0x50;

 // Timer/Counter Register
 register uint8 TCNT1 at 0x4f;

 type TC1_TIFR_t {
	_res1 = uint2(0);           // Reserved, 2 bits
	TOV1  = false;              // Timer/Counter1 Overflow Flag
	_res2 = uint2(0);           // Reserved, 2 bits
	OCF1B = false;              // Timer/Counter1 Output Compare Flag 1B
	OCF1A = false;              // Timer/Counter1 Output Compare Flag 1A
	_res3 = false;              // Reserved, 1 bits
 }

 // Timer/Counter Interrupt Flag Register
 register TC1_TIFR_t TC1_TIFR at 0x58;
 register uint8 TC1_TIFR_raw at 0x58;

 type TC1_TIMSK_t {
	_res1  = uint2(0);           // Reserved, 2 bits
	TOIE1  = false;              // Timer/Counter1 Overflow Interrupt Enable
	_res2  = uint2(0);           // Reserved, 2 bits
	OCIE1B = false;              // OCIE1A: Timer/Counter1 Output Compare B Interrupt Enable
	OCIE1A = false;              // OCIE1A: Timer/Counter1 Output Compare Interrupt Enable
	_res3  = false;              // Reserved, 1 bits
 }

 // Timer/Counter Interrupt Mask Register
 register TC1_TIMSK_t TC1_TIMSK at 0x59;
 register uint8 TC1_TIMSK_raw at 0x59;


/* Types and registers for USI 
  Universal Serial Interface
 */

 // USI Buffer Register
 register uint8 USIBR at 0x30;

 enum USICR_USIWM {
	NORMAL_OPERATION = 0,        // Normal Operation
	THREE_WIRE_MODE = 1,         // Three-Wire Mode
	TWO_WIRE_MODE = 2,           // Two-Wire Mode
	TWO_WIRE_MODE_HELD_LOW = 3   // Two-Wire Mode Held Low
 }

 type USICR_t {
	USITC  = false;              // Toggle Clock Port Pin
	USICLK = false;              // Clock Strobe
	USICS  = uint2(0);           // USI Clock Source Select Bits
	USIWM  = uint2(0);           // USI Wire Mode Bits
	USIOIE = false;              // Counter Overflow Interrupt Enable
	USISIE = false;              // Start Condition Interrupt Enable
 }

 // USI Control Register
 register USICR_t USICR at 0x0000002D;
 register uint8 USICR_raw at 0x0000002D;

 // USI Data Register
 register uint8 USIDR at 0x2f;

 type USISR_t {
	USICNT = uint4(0);           // USI Counter Value Bits
	USIDC  = false;              // Data Output Collision
	USIPF  = false;              // Stop Condition Flag
	USIOIF = false;              // Counter Overflow Interrupt Flag
	USISIF = false;              // Start Condition Interrupt Flag
 }

 // USI Status Register
 register USISR_t USISR at 0x2e;
 register uint8 USISR_raw at 0x2e;


/* Types and registers for WDT 
  Watchdog Timer
 */

 enum WDTCR_WDP {
	OSCILLATOR_CYCLES_2K = 0,    // Oscillator Cycles 2K
	OSCILLATOR_CYCLES_4K = 1,    // Oscillator Cycles 4K
	OSCILLATOR_CYCLES_8K = 2,    // Oscillator Cycles 8K
	OSCILLATOR_CYCLES_16K = 3,   // Oscillator Cycles 16K
	OSCILLATOR_CYCLES_32K = 4,   // Oscillator Cycles 32K
	OSCILLATOR_CYCLES_64K = 5,   // Oscillator Cycles 64K
	OSCILLATOR_CYCLES_128K = 6,  // Oscillator Cycles 128K
	OSCILLATOR_CYCLES_256K = 7   // Oscillator Cycles 256K
 }

 type WDTCR_t {
	WDP   = uint6(0);           // Watchdog Timer Prescaler Bits
	WDE   = false;              // Watch Dog Enable
	WDCE  = false;              // Watchdog Change Enable
	_res1 = false;              // Reserved, 1 bits
	WDIE  = false;              // Watchdog Timeout Interrupt Enable
	WDIF  = false;              // Watchdog Timeout Interrupt Flag
 }

 // Watchdog Timer Control Register
 register WDTCR_t WDTCR at 0x00000041;
 register uint8 WDTCR_raw at 0x00000041;

