	UIF   = false;              // Update interrupt flag
	CC1IF = false;              // Capture/compare 1 interrupt flag
	CC2IF = false;              // Capture/Compare 2 interrupt flag
	CC3IF = false;              // Capture/Compare 3 interrupt flag
	CC4IF = false;              // Capture/Compare 4 interrupt flag
	_res1 = false;              // Reserved, 1 bits
	TIF   = false;              // Trigger interrupt flag
	_res2 = uint2(0);           // Reserved, 2 bits
	CC1OF = false;              // Capture/Compare 1 overcapture flag
	CC2OF = false;              // Capture/compare 2 overcapture flag
	CC3OF = false;              // Capture/Compare 3 overcapture flag
	CC4OF = false;              // Capture/Compare 4 overcapture flag
	_res3 = uint19(0);          // Reserved, 19 bits
 }

 // TIM2 status register
