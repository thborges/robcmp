	ADC1_ETRGREG_REMAP = false;              // ADC 1 external trigger regular conversion remapping
	ADC2_ETRGINJ_REMAP = false;              // ADC 2 external trigger injected conversion remapping
	ADC2_ETRGREG_REMAP = false;              // ADC 2 external trigger regular conversion remapping
