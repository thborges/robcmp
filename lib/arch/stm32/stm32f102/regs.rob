/* Types and registers for OTG_FS_GLOBAL 
  USB on the go full speed
 */

 type FS_GOTGCTL_t {
	SRQSCS  = false;              // Session request success
	SRQ     = false;              // Session request
	_res1   = uint6(0);           // Reserved, 6 bits
	HNGSCS  = false;              // Host negotiation success
	HNPRQ   = false;              // HNP request
	HSHNPEN = false;              // Host set HNP enable
	DHNPEN  = false;              // Device HNP enabled
	_res2   = uint4(0);           // Reserved, 4 bits
	CIDSTS  = false;              // Connector ID status
	DBCT    = false;              // Long/short debounce time
	ASVLD   = false;              // A-session valid
	BSVLD   = false;              // B-session valid
	_res3   = uint12(0);          // Reserved, 12 bits
 }

