	_res2       = false;              // Reserved, 1 bits
	SEVEONPEND  = false;              // Send Event on Pending bit
	_res3       = uint27(0);          // Reserved, 27 bits
 }

 // System control register
 register SCR_t SCR at 0xe000ed10;
 register uint32 SCR_raw at 0xe000ed10;

 type SCB_CCR_t {
	NONBASETHRDENA = false;              // Configures how the processor enters Thread mode
	USERSETMPEND   = false;              // USERSETMPEND
	_res1          = false;              // Reserved, 1 bits
	UNALIGN__TRP   = false;              // UNALIGN_ TRP
	DIV_0_TRP      = false;              // DIV_0_TRP
	_res2          = uint3(0);           // Reserved, 3 bits
	BFHFNMIGN      = false;              // BFHFNMIGN
	STKALIGN       = false;              // STKALIGN
	_res3          = uint22(0);          // Reserved, 22 bits
 }

 // Configuration and control register
 register SCB_CCR_t SCB_CCR at 0xe000ed14;
 register uint32 SCB_CCR_raw at 0xe000ed14;

 type SHPR1_t {
	PRI_4 = uint8(0);           // Priority of system handler 4
	PRI_5 = uint8(0);           // Priority of system handler 5
	PRI_6 = uint8(0);           // Priority of system handler 6
	_res1 = uint8(0);           // Reserved, 8 bits
 }

 // System handler priority registers
 register SHPR1_t SHPR1 at 0xe000ed18;
 register uint32 SHPR1_raw at 0xe000ed18;

 type SHPR2_t {
	_res1  = uint24(0);          // Reserved, 24 bits
	PRI_11 = uint8(0);           // Priority of system handler 11
 }

 // System handler priority registers
 register SHPR2_t SHPR2 at 0xe000ed1c;
 register uint32 SHPR2_raw at 0xe000ed1c;

 type SHPR3_t {
	_res1  = uint16(0);          // Reserved, 16 bits
	PRI_14 = uint8(0);           // Priority of system handler 14
	PRI_15 = uint8(0);           // Priority of system handler 15
 }

 // System handler priority registers
 register SHPR3_t SHPR3 at 0xe000ed20;
 register uint32 SHPR3_raw at 0xe000ed20;

 type SHCRS_t {
	MEMFAULTACT    = false;              // Memory management fault exception active bit
	BUSFAULTACT    = false;              // Bus fault exception active bit
	_res1          = false;              // Reserved, 1 bits
	USGFAULTACT    = false;              // Usage fault exception active bit
	_res2          = uint3(0);           // Reserved, 3 bits
	SVCALLACT      = false;              // SVC call active bit
	MONITORACT     = false;              // Debug monitor active bit
	_res3          = false;              // Reserved, 1 bits
	PENDSVACT      = false;              // PendSV exception active bit
	SYSTICKACT     = false;              // SysTick exception active bit
	USGFAULTPENDED = false;              // Usage fault exception pending bit
	MEMFAULTPENDED = false;              // Memory management fault exception pending bit
	BUSFAULTPENDED = false;              // Bus fault exception pending bit
	SVCALLPENDED   = false;              // SVC call pending bit
	MEMFAULTENA    = false;              // Memory management fault enable bit
	BUSFAULTENA    = false;              // Bus fault enable bit
	USGFAULTENA    = false;              // Usage fault enable bit
	_res4          = uint13(0);          // Reserved, 13 bits
 }

 // System handler control and state register
 register SHCRS_t SHCRS at 0xe000ed24;
 register uint32 SHCRS_raw at 0xe000ed24;

 type CFSR_UFSR_BFSR_MMFSR_t {
	IACCVIOL    = false;              // IACCVIOL
	DACCVIOL    = false;              // DACCVIOL
	_res1       = false;              // Reserved, 1 bits
	MUNSTKERR   = false;              // MUNSTKERR
	MSTKERR     = false;              // MSTKERR
	MLSPERR     = false;              // MLSPERR
	_res2       = false;              // Reserved, 1 bits
	MMARVALID   = false;              // MMARVALID
	IBUSERR     = false;              // Instruction bus error
	PRECISERR   = false;              // Precise data bus error
	IMPRECISERR = false;              // Imprecise data bus error
	UNSTKERR    = false;              // Bus fault on unstacking for a return from exception
	STKERR      = false;              // Bus fault on stacking for exception entry
	LSPERR      = false;              // Bus fault on floating-point lazy state preservation
	_res3       = false;              // Reserved, 1 bits
	BFARVALID   = false;              // Bus Fault Address Register (BFAR) valid flag
	UNDEFINSTR  = false;              // Undefined instruction usage fault
	INVSTATE    = false;              // Invalid state usage fault
	INVPC       = false;              // Invalid PC load usage fault
	NOCP        = false;              // No coprocessor usage fault.
	_res4       = uint4(0);           // Reserved, 4 bits
	UNALIGNED   = false;              // Unaligned access usage fault
	DIVBYZERO   = false;              // Divide by zero usage fault
	_res5       = uint6(0);           // Reserved, 6 bits
 }

 // Configurable fault status register
 register CFSR_UFSR_BFSR_MMFSR_t CFSR_UFSR_BFSR_MMFSR at 0xe000ed28;
 register uint32 CFSR_UFSR_BFSR_MMFSR_raw at 0xe000ed28;

 type HFSR_t {
	_res1    = false;              // Reserved, 1 bits
	VECTTBL  = false;              // Vector table hard fault
	_res2    = uint28(0);          // Reserved, 28 bits
	FORCED   = false;              // Forced hard fault
	DEBUG_VT = false;              // Reserved for Debug use
 }

 // Hard fault status register
 register HFSR_t HFSR at 0xe000ed2c;
 register uint32 HFSR_raw at 0xe000ed2c;

 type MMFAR_t {
	MMFAR = uint32(0);          // Memory management fault address
 }

 // Memory management fault address register
 register MMFAR_t MMFAR at 0xe000ed34;
 register uint32 MMFAR_raw at 0xe000ed34;

 type BFAR_t {
	BFAR = uint32(0);          // Bus fault address
 }

 // Bus fault address register
 register BFAR_t BFAR at 0xe000ed38;
 register uint32 BFAR_raw at 0xe000ed38;


/* Types and registers for STK 
  SysTick timer
 */

 type CTRL_t {
	ENABLE    = false;              // Counter enable
	TICKINT   = false;              // SysTick exception request enable
	CLKSOURCE = false;              // Clock source selection
	_res1     = uint13(0);          // Reserved, 13 bits
	COUNTFLAG = false;              // COUNTFLAG
	_res2     = uint15(0);          // Reserved, 15 bits
 }

 // SysTick control and status register
 register CTRL_t CTRL at 0xE000E010;
 register uint32 CTRL_raw at 0xE000E010;

 type LOAD__t {
	RELOAD = uint24(0);          // RELOAD value
	_res1  = uint8(0);           // Reserved, 8 bits
 }

 // SysTick reload value register
 register LOAD__t LOAD_ at 0xe000e014;
 register uint32 LOAD__raw at 0xe000e014;

 type VAL_t {
	CURRENT = uint24(0);          // Current counter value
	_res1   = uint8(0);           // Reserved, 8 bits
 }

 // SysTick current value register
 register VAL_t VAL at 0xe000e018;
 register uint32 VAL_raw at 0xe000e018;

 type CALIB_t {
	TENMS = uint24(0);          // Calibration value
	_res1 = uint8(0);           // Reserved, 8 bits
 }

 // SysTick calibration value register
 register CALIB_t CALIB at 0xe000e01c;
 register uint32 CALIB_raw at 0xe000e01c;

