 }

 // MPU type register
 register MPU_TYPER_t MPU_TYPER at 0xE000ED90;
 register uint32 MPU_TYPER_raw at 0xE000ED90;

 type MPU_CTRL_t {
	ENABLE     = false;              // Enables the MPU
	HFNMIENA   = false;              // Enables the operation of MPU during hard fault
	PRIVDEFENA = false;              // Enable priviliged software access to default memory map
	_res1      = uint29(0);          // Reserved, 29 bits
 }

 // MPU control register
 register MPU_CTRL_t MPU_CTRL at 0xe000ed94;
 register uint32 MPU_CTRL_raw at 0xe000ed94;

