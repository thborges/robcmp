 register uint32 OPTKEYR_raw at 0x40022008;

 type FLASH_SR_t {
	BSY      = false;              // Busy
	_res1    = false;              // Reserved, 1 bits
	PGERR    = false;              // Programming error
	_res2    = false;              // Reserved, 1 bits
	WRPRTERR = false;              // Write protection error
	EOP      = false;              // End of operation
	_res3    = uint26(0);          // Reserved, 26 bits
 }

 // Status register
