/* Types and registers for SDIO 
  Secure digital input/output interface
 */

 type POWER_t {
	PWRCTRL = uint2(0);           // PWRCTRL
	_res1   = uint30(0);          // Reserved, 30 bits
 }

 // power control register
 register POWER_t POWER at 0x40018000;
 register uint32 POWER_raw at 0x40018000;

 type CLKCR_t {
	CLKDIV  = uint8(0);           // Clock divide factor
	CLKEN   = false;              // Clock enable bit
	PWRSAV  = false;              // Power saving configuration bit
	BYPASS  = false;              // Clock divider bypass enable bit
	WIDBUS  = uint2(0);           // Wide bus mode enable bit
	NEGEDGE = false;              // SDIO_CK dephasing selection bit
	HWFC_EN = false;              // HW Flow Control enable
	_res1   = uint17(0);          // Reserved, 17 bits
 }

 // SDI clock control register
 register CLKCR_t CLKCR at 0x40018004;
 register uint32 CLKCR_raw at 0x40018004;

 type ARG_t {
	CMDARG = uint32(0);          // Command argument
 }

 // argument register
 register ARG_t ARG at 0x40018008;
 register uint32 ARG_raw at 0x40018008;

 type CMD_t {
	CMDINDEX    = uint6(0);           // Command index
	WAITRESP    = uint2(0);           // Wait for response bits
	WAITINT     = false;              // CPSM waits for interrupt request
	WAITPEND    = false;              // CPSM Waits for ends of data transfer (CmdPend internal signal).
	CPSMEN      = false;              // Command path state machine (CPSM) Enable bit
	SDIOSuspend = false;              // SD I/O suspend command
	ENCMDcompl  = false;              // Enable CMD completion
	nIEN        = false;              // not Interrupt Enable
	CE_ATACMD   = false;              // CE-ATA command
	_res1       = uint17(0);          // Reserved, 17 bits
 }

 // command register
 register CMD_t CMD at 0x4001800c;
 register uint32 CMD_raw at 0x4001800c;

 type RESPCMD_t {
	RESPCMD = uint6(0);           // Response command index
	_res1   = uint26(0);          // Reserved, 26 bits
 }

 // command response register
 register RESPCMD_t RESPCMD at 0x40018010;
 register uint32 RESPCMD_raw at 0x40018010;

 type RESP1_t {
	CARDSTATUS1 = uint32(0);          // Card Status
 }

 // response 1..4 register
 register RESP1_t RESP1 at 0x40018014;
 register uint32 RESP1_raw at 0x40018014;

 type RESP2_t {
	CARDSTATUS2 = uint32(0);          // Card Status
 }

 // response 1..4 register
 register RESP2_t RESP2 at 0x40018018;
 register uint32 RESP2_raw at 0x40018018;

 type RESP3_t {
	CARDSTATUS3 = uint32(0);          // Card Status
 }

 // response 1..4 register
 register RESP3_t RESP3 at 0x4001801c;
 register uint32 RESP3_raw at 0x4001801c;

 type RESP4_t {
	CARDSTATUS4 = uint32(0);          // Card Status
 }

 // response 1..4 register
 register RESP4_t RESP4 at 0x40018020;
 register uint32 RESP4_raw at 0x40018020;

 type DTIMER_t {
	DATATIME = uint32(0);          // Data timeout period
 }

 // data timer register
 register DTIMER_t DTIMER at 0x40018024;
 register uint32 DTIMER_raw at 0x40018024;

 type DLEN_t {
	DATALENGTH = uint25(0);          // Data length value
	_res1      = uint7(0);           // Reserved, 7 bits
 }

 // data length register
 register DLEN_t DLEN at 0x40018028;
 register uint32 DLEN_raw at 0x40018028;

 type DCTRL_t {
	DTEN       = false;              // DTEN
	DTDIR      = false;              // Data transfer direction selection
	DTMODE     = false;              // Data transfer mode selection 1: Stream or SDIO multibyte data transfer.
	DMAEN      = false;              // DMA enable bit
	DBLOCKSIZE = uint4(0);           // Data block size
	RWSTART    = false;              // Read wait start
	RWSTOP     = false;              // Read wait stop
	RWMOD      = false;              // Read wait mode
	SDIOEN     = false;              // SD I/O enable functions
	_res1      = uint20(0);          // Reserved, 20 bits
 }

 // data control register
 register DCTRL_t DCTRL at 0x4001802c;
 register uint32 DCTRL_raw at 0x4001802c;

 type DCOUNT_t {
	DATACOUNT = uint25(0);          // Data count value
	_res1     = uint7(0);           // Reserved, 7 bits
 }

 // data counter register
 register DCOUNT_t DCOUNT at 0x40018030;
 register uint32 DCOUNT_raw at 0x40018030;

 type STA_t {
	CCRCFAIL = false;              // Command response received (CRC check failed)
	DCRCFAIL = false;              // Data block sent/received (CRC check failed)
	CTIMEOUT = false;              // Command response timeout
	DTIMEOUT = false;              // Data timeout
	TXUNDERR = false;              // Transmit FIFO underrun error
	RXOVERR  = false;              // Received FIFO overrun error
	CMDREND  = false;              // Command response received (CRC check passed)
	CMDSENT  = false;              // Command sent (no response required)
	DATAEND  = false;              // Data end (data counter, SDIDCOUNT, is zero)
	STBITERR = false;              // Start bit not detected on all data signals in wide bus mode
	DBCKEND  = false;              // Data block sent/received (CRC check passed)
	CMDACT   = false;              // Command transfer in progress
	TXACT    = false;              // Data transmit in progress
	RXACT    = false;              // Data receive in progress
	TXFIFOHE = false;              // Transmit FIFO half empty: at least 8 words can be written into the FIFO
	RXFIFOHF = false;              // Receive FIFO half full: there are at least 8 words in the FIFO
	TXFIFOF  = false;              // Transmit FIFO full
	RXFIFOF  = false;              // Receive FIFO full
	TXFIFOE  = false;              // Transmit FIFO empty
	RXFIFOE  = false;              // Receive FIFO empty
	TXDAVL   = false;              // Data available in transmit FIFO
	RXDAVL   = false;              // Data available in receive FIFO
	SDIOIT   = false;              // SDIO interrupt received
	CEATAEND = false;              // CE-ATA command completion signal received for CMD61
	_res1    = uint8(0);           // Reserved, 8 bits
 }

 // status register
 register STA_t STA at 0x40018034;
 register uint32 STA_raw at 0x40018034;

 type ICR_t {
	CCRCFAILC = false;              // CCRCFAIL flag clear bit
	DCRCFAILC = false;              // DCRCFAIL flag clear bit
	CTIMEOUTC = false;              // CTIMEOUT flag clear bit
	DTIMEOUTC = false;              // DTIMEOUT flag clear bit
	TXUNDERRC = false;              // TXUNDERR flag clear bit
	RXOVERRC  = false;              // RXOVERR flag clear bit
	CMDRENDC  = false;              // CMDREND flag clear bit
	CMDSENTC  = false;              // CMDSENT flag clear bit
	DATAENDC  = false;              // DATAEND flag clear bit
	STBITERRC = false;              // STBITERR flag clear bit
	DBCKENDC  = false;              // DBCKEND flag clear bit
	_res1     = uint11(0);          // Reserved, 11 bits
	SDIOITC   = false;              // SDIOIT flag clear bit
	CEATAENDC = false;              // CEATAEND flag clear bit
	_res2     = uint8(0);           // Reserved, 8 bits
 }

 // interrupt clear register
 register ICR_t ICR at 0x40018038;
 register uint32 ICR_raw at 0x40018038;

 type MASK_t {
	CCRCFAILIE = false;              // Command CRC fail interrupt enable
	DCRCFAILIE = false;              // Data CRC fail interrupt enable
	CTIMEOUTIE = false;              // Command timeout interrupt enable
	DTIMEOUTIE = false;              // Data timeout interrupt enable
	TXUNDERRIE = false;              // Tx FIFO underrun error interrupt enable
	RXOVERRIE  = false;              // Rx FIFO overrun error interrupt enable
	CMDRENDIE  = false;              // Command response received interrupt enable
	CMDSENTIE  = false;              // Command sent interrupt enable
	DATAENDIE  = false;              // Data end interrupt enable
	STBITERRIE = false;              // Start bit error interrupt enable
	DBCKENDIE  = false;              // Data block end interrupt enable
	CMDACTIE   = false;              // Command acting interrupt enable
	TXACTIE    = false;              // Data transmit acting interrupt enable
	RXACTIE    = false;              // Data receive acting interrupt enable
	TXFIFOHEIE = false;              // Tx FIFO half empty interrupt enable
	RXFIFOHFIE = false;              // Rx FIFO half full interrupt enable
	TXFIFOFIE  = false;              // Tx FIFO full interrupt enable
	RXFIFOFIE  = false;              // Rx FIFO full interrupt enable
	TXFIFOEIE  = false;              // Tx FIFO empty interrupt enable
	RXFIFOEIE  = false;              // Rx FIFO empty interrupt enable
	TXDAVLIE   = false;              // Data available in Tx FIFO interrupt enable
	RXDAVLIE   = false;              // Data available in Rx FIFO interrupt enable
	SDIOITIE   = false;              // SDIO mode interrupt received interrupt enable
	CEATAENDIE = false;              // CE-ATA command completion signal received interrupt enable
	_res1      = uint8(0);           // Reserved, 8 bits
 }

 // mask register
 register MASK_t MASK at 0x4001803c;
 register uint32 MASK_raw at 0x4001803c;

 type FIFOCNT_t {
	FIFOCOUNT = uint24(0);          // Remaining number of words to be written to or read from the FIFO.
	_res1     = uint8(0);           // Reserved, 8 bits
 }

 // FIFO counter register
 register FIFOCNT_t FIFOCNT at 0x40018048;
 register uint32 FIFOCNT_raw at 0x40018048;

 type FIFO_t {
	FIFOData = uint32(0);          // Receive and transmit FIFO data
 }

 // data FIFO register
 register FIFO_t FIFO at 0x40018080;
 register uint32 FIFO_raw at 0x40018080;


