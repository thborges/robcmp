/* Types and registers for WDT 
  Watchdog Timer
 */

 enum WDTCSR_WDP {
	OSCILLATOR_CYCLES_2K = 0,    // Oscillator Cycles 2K
	OSCILLATOR_CYCLES_4K = 1,    // Oscillator Cycles 4K
	OSCILLATOR_CYCLES_8K = 2,    // Oscillator Cycles 8K
	OSCILLATOR_CYCLES_16K = 3,   // Oscillator Cycles 16K
	OSCILLATOR_CYCLES_32K = 4,   // Oscillator Cycles 32K
	OSCILLATOR_CYCLES_64K = 5,   // Oscillator Cycles 64K
	OSCILLATOR_CYCLES_128K = 6,  // Oscillator Cycles 128K
	OSCILLATOR_CYCLES_256K = 7   // Oscillator Cycles 256K
 }

 type WDTCSR_t {
	WDP   = uint6(0);           // Watchdog Timer Prescaler Bits
	WDE   = false;              // Watch Dog Enable
	WDCE  = false;              // Watchdog Change Enable
	_res1 = false;              // Reserved, 1 bits
	WDIE  = false;              // Watchdog Timeout Interrupt Enable
	WDIF  = false;              // Watchdog Timeout Interrupt Flag
 }

 // Watchdog Timer Control Register
 register WDTCSR_t WDTCSR at 0x00000060;
 register uint8 WDTCSR_raw at 0x00000060;

