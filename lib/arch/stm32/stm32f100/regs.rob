 }

 // control register 2
 register TIM12_CR2_t TIM12_CR2 at 0x40001804;
 register uint32 TIM12_CR2_raw at 0x40001804;

 type TIM12_SMCR_t {
	SMS   = uint3(0);           // Slave mode selection
	_res1 = false;              // Reserved, 1 bits
	TS    = uint3(0);           // Trigger selection
	MSM   = false;              // Master/Slave mode
	_res2 = uint24(0);          // Reserved, 24 bits
 }

 // slave mode control register
 register TIM12_SMCR_t TIM12_SMCR at 0x40001808;
 register uint32 TIM12_SMCR_raw at 0x40001808;

