/* Types and registers for USART0 
  USART
 */

 // USART Baud Rate Register Bytes
 register uint16 UBRR0 at 0xc4;

 type UCSR0A_t {
	MPCM0 = false;              // Multi-processor Communication Mode
	U2X0  = false;              // Double the USART transmission speed
	UPE0  = false;              // Parity Error
	DOR0  = false;              // Data overRun
	FE0   = false;              // Framing Error
	UDRE0 = false;              // USART Data Register Empty
	TXC0  = false;              // USART Transmit Complete
	RXC0  = false;              // USART Receive Complete
 }

 // USART Control and Status Register A
 register UCSR0A_t UCSR0A at 0x000000C0;
 register uint8 UCSR0A_raw at 0x000000C0;

 type UCSR0B_t {
	TXB80  = false;              // Transmit Data Bit 8
	RXB80  = false;              // Receive Data Bit 8
	UCSZ02 = false;              // Character Size - together with UCSZ0 in UCSR0C
	TXEN0  = false;              // Transmitter Enable
	RXEN0  = false;              // Receiver Enable
	UDRIE0 = false;              // USART Data register Empty Interrupt Enable
	TXCIE0 = false;              // TX Complete Interrupt Enable
	RXCIE0 = false;              // RX Complete Interrupt Enable
 }

 // USART Control and Status Register B
 register UCSR0B_t UCSR0B at 0xc1;
 register uint8 UCSR0B_raw at 0xc1;

 enum UCSR0C_USBS0 {
	_1_BIT = 0, // 1-bit
	_2_BIT = 1  // 2-bit
 }

 enum UCSR0C_UPM0 {
	DISABLED = 0,             // Disabled
	RESERVED = 1,             // Reserved
	ENABLED_EVEN_PARITY = 2,  // Enabled, Even Parity
	ENABLED_ODD_PARITY = 3    // Enabled, Odd Parity
 }

 enum UCSR0C_UMSEL0 {
	ASYNCHRONOUS_USART = 0,  // Asynchronous USART
	SYNCHRONOUS_USART = 1,   // Synchronous USART
	MASTER_SPI = 3           // Master SPI
 }

 type UCSR0C_t {
	UCPOL0 = false;              // Clock Polarity
	UCSZ0  = uint2(0);           // Character Size - together with UCSZ2 in UCSR0B
	USBS0  = false;              // Stop Bit Select
	UPM0   = uint2(0);           // Parity Mode Bits
	UMSEL0 = uint2(0);           // USART Mode Select
 }

 // USART Control and Status Register C
 register UCSR0C_t UCSR0C at 0xc2;
 register uint8 UCSR0C_raw at 0xc2;

 // USART I/O Data Register
 register uint8 UDR0 at 0xc6;


