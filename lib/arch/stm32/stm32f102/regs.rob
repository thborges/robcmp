 register TIM2_CCMR2_Input_t TIM3_CCMR2_Input at 0x4000041c;
 register uint32 TIM3_CCMR2_Input_raw at 0x4000041c;

 // TIM3 capture/compare enable register
 register TIM2_CCER_t TIM3_CCER at 0x40000420;
 register uint32 TIM3_CCER_raw at 0x40000420;

 // TIM3 counter
 register TIM2_CNT_t TIM3_CNT at 0x40000424;
 register uint32 TIM3_CNT_raw at 0x40000424;

 // TIM3 prescaler
 register TIM2_PSC_t TIM3_PSC at 0x40000428;
 register uint32 TIM3_PSC_raw at 0x40000428;

 // TIM3 auto-reload register
 register TIM2_ARR_t TIM3_ARR at 0x4000042c;
 register uint32 TIM3_ARR_raw at 0x4000042c;

 // TIM3 capture/compare register 1
 register TIM2_CCR1_t TIM3_CCR1 at 0x40000434;
 register uint32 TIM3_CCR1_raw at 0x40000434;

