	JEXTTRIG = false;              // External trigger conversion mode for injected channels
	_res3    = false;              // Reserved, 1 bits
	EXTSEL   = uint3(0);           // External event select for regular group
	EXTTRIG  = false;              // External trigger conversion mode for regular channels
