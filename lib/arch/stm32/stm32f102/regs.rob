	PG     = false;              // Programming
	PER    = false;              // Page Erase
	MER    = false;              // Mass Erase
	_res1  = false;              // Reserved, 1 bits
	OPTPG  = false;              // Option byte programming
	OPTER  = false;              // Option byte erase
	STRT   = false;              // Start
	LOCK   = false;              // Lock
	_res2  = false;              // Reserved, 1 bits
	OPTWRE = false;              // Option bytes write enable
	ERRIE  = false;              // Error interrupt enable
	_res3  = false;              // Reserved, 1 bits
	EOPIE  = false;              // End of operation interrupt enable
	_res4  = uint19(0);          // Reserved, 19 bits
 }

 // Control register
