	nRST_STOP  = false;              // nRST_STOP
	nRST_STDBY = false;              // nRST_STDBY
	_res1      = uint5(0);           // Reserved, 5 bits
	Data0      = uint8(0);           // Data0
	Data1      = uint8(0);           // Data1
	_res2      = uint6(0);           // Reserved, 6 bits
 }

 // Option byte register
