	_res2    = uint2(0);           // Reserved, 2 bits
	ALIGN    = false;              // Data alignment
	JEXTSEL  = uint3(0);           // External event select for injected group
	JEXTTRIG = false;              // External trigger conversion mode for injected channels
	_res3    = false;              // Reserved, 1 bits
	EXTSEL   = uint3(0);           // External event select for regular group
	EXTTRIG  = false;              // External trigger conversion mode for regular channels
	JSWSTART = false;              // Start conversion of injected channels
	SWSTART  = false;              // Start conversion of regular channels
	TSVREFE  = false;              // Temperature sensor and VREFINT enable
	_res4    = uint8(0);           // Reserved, 8 bits
 }

