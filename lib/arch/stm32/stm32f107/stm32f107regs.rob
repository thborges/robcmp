 type STIR_t {
	INTID = uint9(0);           // 
	_res1 = uint16(0);          // Reserved, 23 bits
	_res2 = uint7(0);           // 
 }

 // 
 register STIR_t STIR at 0xE000EF00;


/* Types and registers for SCB: System control block
 */

 type CPUID_t {
	Revision    = uint4(0);           // 
	PartNo      = uint12(0);          // 
	Constant    = uint4(0);           // 
	Variant     = uint4(0);           // 
	Implementer = uint8(0);           // 
 }

 // 
 register CPUID_t CPUID at 0xE000ED00;

 type ICSR_t {
	VECTACTIVE  = uint9(0);           // 
	_res1       = uint2(0);           // Reserved, 2 bits
	RETTOBASE   = false;              // 
	VECTPENDING = uint7(0);           // 
	_res2       = uint3(0);           // Reserved, 3 bits
	ISRPENDING  = false;              // 
	_res3       = uint2(0);           // Reserved, 2 bits
	PENDSTCLR   = false;              // 
	PENDSTSET   = false;              // 
	PENDSVCLR   = false;              // 
	PENDSVSET   = false;              // 
	_res4       = uint2(0);           // Reserved, 2 bits
	NMIPENDSET  = false;              // 
 }

 // 
 register ICSR_t ICSR at 0xE000ED00 + 0x4;

 type VTOR_t {
	_res1  = uint8(0);           // Reserved, 9 bits
	_res2  = false;              // 
	TBLOFF = uint21(0);          // 
	_res3  = uint2(0);           // Reserved, 2 bits
 }

 // 
 register VTOR_t VTOR at 0xE000ED00 + 0x8;

 type AIRCR_t {
	VECTRESET     = false;              // 
	VECTCLRACTIVE = false;              // 
	SYSRESETREQ   = false;              // 
	_res1         = uint5(0);           // Reserved, 5 bits
	PRIGROUP      = uint3(0);           // 
	_res2         = uint4(0);           // Reserved, 4 bits
	ENDIANESS     = false;              // 
	VECTKEYSTAT   = uint16(0);          // 
 }

 // 
 register AIRCR_t AIRCR at 0xE000ED00 + 0xC;

 type SCR_t {
	_res1       = false;              // Reserved, 1 bits
	SLEEPONEXIT = false;              // 
	SLEEPDEEP   = false;              // 
	_res2       = false;              // Reserved, 1 bits
	SEVEONPEND  = false;              // 
	_res3       = uint16(0);          // Reserved, 27 bits
	_res4       = uint8(0);           // 
	_res5       = uint3(0);           // 
 }

 // 
 register SCR_t SCR at 0xE000ED00 + 0x10;

 type CCR_t {
	NONBASETHRDENA = false;              // 
	USERSETMPEND   = false;              // 
	_res1          = false;              // Reserved, 1 bits
	UNALIGN__TRP   = false;              // 
	DIV_0_TRP      = false;              // 
	_res2          = uint3(0);           // Reserved, 3 bits
	BFHFNMIGN      = false;              // 
	STKALIGN       = false;              // 
	_res3          = uint16(0);          // Reserved, 22 bits
	_res4          = uint6(0);           // 
 }

 // 
 register CCR_t CCR at 0xE000ED00 + 0x14;

 type SHPR1_t {
	PRI_4 = uint8(0);           // 
	PRI_5 = uint8(0);           // 
	PRI_6 = uint8(0);           // 
	_res1 = uint8(0);           // Reserved, 8 bits
 }

 // 
 register SHPR1_t SHPR1 at 0xE000ED00 + 0x18;

 type SHPR2_t {
	_res1  = uint16(0);          // Reserved, 24 bits
	_res2  = uint8(0);           // 
	PRI_11 = uint8(0);           // 
 }

 // 
 register SHPR2_t SHPR2 at 0xE000ED00 + 0x1C;

 type SHPR3_t {
	_res1  = uint16(0);          // Reserved, 16 bits
	PRI_14 = uint8(0);           // 
	PRI_15 = uint8(0);           // 
 }

 // 
 register SHPR3_t SHPR3 at 0xE000ED00 + 0x20;

 type SHCRS_t {
	MEMFAULTACT    = false;              // 
	BUSFAULTACT    = false;              // 
	_res1          = false;              // Reserved, 1 bits
	USGFAULTACT    = false;              // 
	_res2          = uint3(0);           // Reserved, 3 bits
	SVCALLACT      = false;              // 
	MONITORACT     = false;              // 
	_res3          = false;              // Reserved, 1 bits
	PENDSVACT      = false;              // 
	SYSTICKACT     = false;              // 
	USGFAULTPENDED = false;              // 
	MEMFAULTPENDED = false;              // 
	BUSFAULTPENDED = false;              // 
	SVCALLPENDED   = false;              // 
	MEMFAULTENA    = false;              // 
	BUSFAULTENA    = false;              // 
	USGFAULTENA    = false;              // 
	_res4          = uint8(0);           // Reserved, 13 bits
	_res5          = uint5(0);           // 
 }

 // 
 register SHCRS_t SHCRS at 0xE000ED00 + 0x24;

 type CFSR_UFSR_BFSR_MMFSR_t {
	IACCVIOL    = false;              // 
	DACCVIOL    = false;              // 
	_res1       = false;              // Reserved, 1 bits
	MUNSTKERR   = false;              // 
	MSTKERR     = false;              // 
	MLSPERR     = false;              // 
	_res2       = false;              // Reserved, 1 bits
	MMARVALID   = false;              // 
	IBUSERR     = false;              // 
	PRECISERR   = false;              // 
	IMPRECISERR = false;              // 
	UNSTKERR    = false;              // 
	STKERR      = false;              // 
	LSPERR      = false;              // 
	_res3       = false;              // Reserved, 1 bits
	BFARVALID   = false;              // 
	UNDEFINSTR  = false;              // 
	INVSTATE    = false;              // 
	INVPC       = false;              // 
	NOCP        = false;              // 
	_res4       = uint4(0);           // Reserved, 4 bits
	UNALIGNED   = false;              // 
	DIVBYZERO   = false;              // 
	_res5       = uint6(0);           // Reserved, 6 bits
 }

 // 
 register CFSR_UFSR_BFSR_MMFSR_t CFSR_UFSR_BFSR_MMFSR at 0xE000ED00 + 0x28;

 type HFSR_t {
	_res1    = false;              // Reserved, 1 bits
	VECTTBL  = false;              // 
	_res2    = uint16(0);          // Reserved, 28 bits
	_res3    = uint8(0);           // 
	_res4    = uint4(0);           // 
	FORCED   = false;              // 
	DEBUG_VT = false;              // 
 }

 // 
 register HFSR_t HFSR at 0xE000ED00 + 0x2C;

 type MMFAR_t {
	MMFAR = uint32(0);          // 
 }

 // 
 register MMFAR_t MMFAR at 0xE000ED00 + 0x34;

 type BFAR_t {
	BFAR = uint32(0);          // 
 }

 // 
 register BFAR_t BFAR at 0xE000ED00 + 0x38;


/* Types and registers for STK: SysTick timer
 */

 type CTRL_t {
	ENABLE    = false;              // 
	TICKINT   = false;              // 
	CLKSOURCE = false;              // 
	_res1     = uint8(0);           // Reserved, 13 bits
	_res2     = uint5(0);           // 
	COUNTFLAG = false;              // 
	_res3     = uint8(0);           // Reserved, 15 bits
	_res4     = uint7(0);           // 
 }

 // 
 register CTRL_t CTRL at 0xE000E010;

 type LOAD__t {
	RELOAD = uint24(0);          // 
	_res1  = uint8(0);           // Reserved, 8 bits
 }

 // 
 register LOAD__t LOAD_ at 0xE000E010 + 0x4;

 type VAL_t {
	CURRENT = uint24(0);          // 
	_res1   = uint8(0);           // Reserved, 8 bits
 }

 // 
 register VAL_t VAL at 0xE000E010 + 0x8;

 type CALIB_t {
	TENMS = uint24(0);          // 
	_res1 = uint8(0);           // Reserved, 8 bits
 }

 // 
 register CALIB_t CALIB at 0xE000E010 + 0xC;

