	HNSSCHG = false;              // Host negotiation success status change
	_res3   = uint7(0);           // Reserved, 7 bits
	HNGDET  = false;              // Host negotiation detected
	ADTOCHG = false;              // A-device timeout change
	DBCDNE  = false;              // Debounce done
	_res4   = uint12(0);          // Reserved, 12 bits
 }

